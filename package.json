{
  "name": "hero-experience",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "The Hero Experience : réservez un super-héros pour vos déménagements, cours, événements et plus encore.",
  "homepage": "https://github.com/Black-Star-Pen/the-hero-experience#readme",
  "bugs": {
    "url": "https://github.com/Black-Star-Pen/the-hero-experience/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Black-Star-Pen/the-hero-experience.git"
  },
  "workspaces": [
    "client",
    "server",
    "shared"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -c green,yellow -t \"HH:mm:ss\" -p \"{name} {time}\" \"npm:dev:*\"",
    "dev:client": "npm run dev --workspace=client",
    "dev:server": "npm run dev --workspace=server",
    "db:generate": "npm run db:generate --workspace=server",
    "db:migrate": "npm run db:migrate --workspace=server",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "clean": "node -e \"for (const dir of ['node_modules', 'client/node_modules', 'server/node_modules', 'client/dist']) require('node:fs').rmSync(dir, { recursive: true, force: true })\"",
    "prepare": "husky"
  },
  "keywords": [],
  "author": "Black-Star-Pen",
  "license": "MIT",
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint-react/eslint-plugin": "^5.20.8",
    "@eslint/js": "^10.0.1",
    "concurrently": "^10.0.5",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y-x": "^0.2.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.4"
    }
  }
}
