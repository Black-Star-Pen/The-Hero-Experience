{
  "name": "hero-experience",
  "version": "0.0.1",
  "private": true,
  "description": "The Hero Experience : réservez un super-héros pour vos déménagements, cours, événements et plus encore.",
  "homepage": "https://github.com/Black-Star-Pen/Hero-experience#readme",
  "bugs": {
    "url": "https://github.com/Black-Star-Pen/Hero-experience/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Black-Star-Pen/Hero-experience.git"
  },
  "workspaces": ["client", "server"],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "db:migrate": "npm run db:migrate --workspace=server",
    "db:seed": "npm run db:seed --workspace=server",
    "dev": "concurrently -c green,yellow -t \"HH:mm:ss\" -p \"{name} {time}\" \"npm:dev:*\"",
    "dev:client": "npm run dev --workspace=client",
    "dev:server": "npm run dev --workspace=server",
    "test": "npm run test --workspaces --if-present",
    "clean": "cross-env-shell \"rm -rf ./client/node_modules ./server/node_modules ./node_modules ./package-lock.json\""
  },
  "keywords": [],
  "author": "Black-Star-Pen",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3"
  }
}
