# Copy this file to server/.env: every variable is optional in development.

# development | test | production
NODE_ENV=development
PORT=3310
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# PostgreSQL connection string, e.g. postgres://hero:hero@localhost:5432/hero_experience
# Leave empty to use the embedded PGlite database. Required in production.
DATABASE_URL=
# Where the embedded PGlite database is stored, relative to the server folder
PGLITE_DATA_DIR=.data/pglite

# Set to true when the app runs behind a reverse proxy (Render, Traefik, Nginx…)
TRUST_PROXY=false
# Header holding the real client IP, set by the edge of the hosting platform and
# impossible to forge there (cf-connecting-ip on Render, behind Cloudflare).
# Leave empty to use the address given by the reverse proxy.
CLIENT_IP_HEADER=

# Requests allowed per IP address and per 15 minutes on the whole API
API_RATE_LIMIT=600
# Failed sign-in / sign-up attempts allowed per IP address and per 15 minutes
AUTH_RATE_LIMIT=10

# Creates the demo account, its bookings and reviews on start.
# Defaults to true in development, false otherwise.
DEMO_DATA=

# Production build of the client, served by the API when NODE_ENV=production
CLIENT_DIST_DIR=../client/dist
