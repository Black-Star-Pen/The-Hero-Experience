# Copy this file to server/.env: every variable is optional in development.

# development | test | production
NODE_ENV=development
PORT=3310
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# PostgreSQL connection string, e.g. postgres://hero:hero@localhost:5432/hero_experience
# Leave empty to use the embedded PGlite database (stored in server/.data/pglite).
# Required in production.
DATABASE_URL=

# Set to true when the app runs behind a reverse proxy (Traefik, Nginx…)
TRUST_PROXY=false
